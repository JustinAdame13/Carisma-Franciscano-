---
import Tau from './Tau.astro';
import sitio from '../data/sitio.json';
import { navegacion, CREDITOS } from '../data/navegacion';
import { enlaceWhatsApp, enlaceMapa } from '../lib/utilidades';

const whatsapp = enlaceWhatsApp();
const anio = new Date().getFullYear();
---
<footer class="bg-noche text-papel">
  <div class="contenedor pt-20 pb-10 md:pt-28">
    <div class="flex flex-col items-start justify-between gap-10 md:flex-row md:items-end">
      <p class="font-display text-[clamp(3.5rem,11vw,9.5rem)] leading-[0.85] tracking-[-0.04em]" style="font-weight:330" data-revelar>
        Paz <em class="text-rubrica">y</em> Bien.
      </p>
      <p class="max-w-[34ch] font-texto text-[1.15rem] italic text-papel/70" data-revelar style="--i:1">
        «Señor, hazme un instrumento de tu paz: donde haya odio, ponga yo amor.»
      </p>
    </div>

    <span class="mt-16 block h-px w-full bg-papel/20" data-regla></span>

    <div class="grid gap-12 pt-12 sm:grid-cols-2 lg:grid-cols-4">
      <div data-revelar>
        <p class="rotulo text-rubrica">Dónde</p>
        <a href={enlaceMapa} target="_blank" rel="noopener" class="mt-4 block text-papel/85 transition-colors hover:text-papel">
          <span class="font-display text-[1.3rem] text-papel">{sitio.sede}</span><br />
          <span class="text-[1rem]">{sitio.direccion}</span>
        </a>
      </div>
      <div data-revelar style="--i:1">
        <p class="rotulo text-rubrica">Cuándo</p>
        <ul class="mt-4 space-y-3">
          {sitio.reuniones.map((r) => (
            <li>
              <p class="font-display text-[1.15rem] leading-tight">{r.titulo}</p>
              <p class="text-[0.95rem] text-papel/65">{r.dia} · {r.hora}</p>
            </li>
          ))}
        </ul>
      </div>
      <div data-revelar style="--i:2">
        <p class="rotulo text-rubrica">Sumario</p>
        <ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-1.5">
          {navegacion.map((item) => (
            <li>
              <a href={item.href} class="group flex items-baseline gap-2 text-[1rem] text-papel/80 transition-colors hover:text-papel">
                <span class="numeral text-[0.75rem] text-rubrica/80">{item.numero}</span>
                <span class="transition-transform duration-500 ease-[var(--ease-suave)] group-hover:translate-x-1">{item.texto}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div data-revelar style="--i:3">
        <p class="rotulo text-rubrica">Escríbenos</p>
        <p class="mt-4 text-[1rem] text-papel/75">¿Dudas o quieres conocernos? Con gusto te respondemos.</p>
        <div class="mt-5 flex flex-col items-start gap-3">
          {whatsapp
            ? <a href={whatsapp} target="_blank" rel="noopener" class="boton boton-claro">WhatsApp</a>
            : <a href="/contacto" class="boton boton-claro">Contacto</a>}
          {sitio.correo && <a href={`mailto:${sitio.correo}`} class="enlace text-papel/85">{sitio.correo}</a>}
          <div class="flex gap-4 text-[0.95rem]">
            {sitio.facebook && <a href={sitio.facebook} target="_blank" rel="noopener" class="enlace">Facebook</a>}
            {sitio.instagram && <a href={sitio.instagram} target="_blank" rel="noopener" class="enlace">Instagram</a>}
          </div>
        </div>
      </div>
    </div>

    <!-- Colofón: como al final de un libro -->
    <div class="mt-20 flex flex-col gap-4 border-t border-papel/20 pt-6 font-ui text-[0.72rem] tracking-[0.06em] text-papel/55 md:flex-row md:items-center md:justify-between">
      <p class="flex items-center gap-2">
        <Tau class="h-3.5 w-auto text-rubrica" />
        © {anio} {sitio.nombre} · {sitio.subtitulo}
      </p>
      <p>
        <span class="italic font-texto text-[0.85rem]">Colofón:</span> compuesto en Fraunces y Newsreader. Sitio desarrollado por{' '}
        <a href={CREDITOS.url} target="_blank" rel="noopener" class="text-papel underline decoration-rubrica underline-offset-4 hover:text-rubrica">{CREDITOS.autor}</a>.
      </p>
    </div>
  </div>
</footer>
