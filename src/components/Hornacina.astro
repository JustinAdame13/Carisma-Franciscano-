---
// "Hornacina": nicho con arco de medio punto para la imagen de un santo,
// con doble filete como los marcos de los libros antiguos.
interface Props {
  src: string;
  nombre: string;
  titulo: string; // ej. "Patrona de la Tercera Orden"
  fiesta?: { texto: string; href: string };
  /** Proporción del nicho (clase de Tailwind). Los santos de cuerpo entero lucen mejor altos. */
  proporcion?: string;
  class?: string;
}
const { src, nombre, titulo, fiesta, proporcion = 'aspect-[3/4]', class: clase } = Astro.props;
---
<figure class:list={['hornacina group', clase]} data-revelar>
  <div class="rounded-t-full border border-tinta/70 p-[5px]">
    <div class:list={['grabado relative overflow-hidden rounded-t-full border border-tinta/30 bg-papel-hondo', proporcion]}>
      <img
        src={src}
        alt={nombre}
        width="666"
        height="1110"
        class="h-full w-full object-cover object-top transition-transform duration-[1.6s] ease-[var(--ease-suave)] group-hover:scale-[1.03]"
        loading="eager"
      />
    </div>
  </div>
  <figcaption class="mt-5 text-center">
    <p class="rotulo text-rubrica">{titulo}</p>
    <p class="mt-2 font-display text-[1.25rem] leading-tight italic md:text-[1.4rem]" style="font-weight:380">{nombre}</p>
    {fiesta && <a href={fiesta.href} class="rotulo mt-3 inline-block text-tinta-suave transition-colors hover:text-rubrica">Fiesta · {fiesta.texto}</a>}
  </figcaption>
</figure>

