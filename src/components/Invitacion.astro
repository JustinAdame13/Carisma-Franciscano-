---
// Cierre de página: invitación a escribir o seguir leyendo.
import Tau from './Tau.astro';
import Lineas from './Lineas.astro';
interface Props {
  lineas?: string[];
  texto?: string;
}
const {
  lineas = ['Paz', '*y Bien.*'],
  texto = 'Gracias por leer. Si algo de lo que encontraste aquí te ayudó, o quieres compartir una intención de oración, escríbeme.',
} = Astro.props;
---
<section class="contenedor py-24 md:py-36">
  <div class="grid items-end gap-10 md:grid-cols-12">
    <div class="md:col-span-8">
      <Tau trazar class="mb-8 h-14 w-auto text-rubrica" />
      <Lineas class="display-xl" lineas={lineas} />
    </div>
    <div class="md:col-span-4" data-revelar style="--i:2">
      <p class="lede">{texto}</p>
      <div class="mt-8 flex flex-col items-start gap-4">
        <a href="#contacto" class="boton">Escribir</a>
        <a href="/oraciones" class="enlace-flecha">Ver oraciones</a>
      </div>
    </div>
  </div>
</section>
