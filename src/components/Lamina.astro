---
// "Lámina": espacio para una foto, con pie de foto al estilo de revista.
// Mientras no haya foto muestra un fondo de papel con la Tau.
// Cuando llegue la foto: <Lamina src="/imagenes/fraternidad.jpg" pie="..." />
import Tau from './Tau.astro';
interface Props {
  pie: string;
  numero?: string | number;
  src?: string;
  alt?: string;
  class?: string;
  proporcion?: string;
}
const { pie, numero, src, alt = '', class: clase, proporcion = 'aspect-[4/5]' } = Astro.props;
---
<figure class:list={['group', clase]} data-revelar>
  <div class:list={['parallax relative overflow-hidden bg-papel-hondo', proporcion]}>
    {src ? (
      <img src={src} alt={alt} class="h-full w-full object-cover" loading="lazy" />
    ) : (
      <div class="grano absolute inset-0 flex items-center justify-center">
        <Tau class="h-[38%] w-auto text-sayal/[0.09] transition-transform duration-[1.6s] ease-[var(--ease-suave)] group-hover:scale-105" />
      </div>
    )}
  </div>
  <figcaption class="mt-3 flex gap-3 font-texto text-[0.92rem] leading-snug text-tinta-suave italic">
    {numero !== undefined && <span class="rotulo shrink-0 whitespace-nowrap not-italic text-rubrica">Lám. {numero}</span>}
    <span>{pie}{!src && <span class="text-tinta-tenue"> — foto pendiente</span>}</span>
  </figcaption>
</figure>
