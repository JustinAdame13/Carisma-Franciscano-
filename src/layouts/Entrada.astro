---
// Plantilla para leer una entrada completa (noticia, publicación, proyecto, formación u oración), como un artículo de revista.
import Base from './Base.astro';
import Lineas from '../components/Lineas.astro';
import Tau from '../components/Tau.astro';
import Invitacion from '../components/Invitacion.astro';
import { formatoFecha } from '../lib/utilidades';

interface Props {
  titulo: string;
  resumen?: string | null;
  fecha?: Date;
  etiqueta: string;
  imagen?: string | null;
  ejemplo?: boolean;
  archivo?: string | null;
  volver: { texto: string; href: string };
  /** Muestra el texto sobre una hoja de papiro (sección Oraciones). */
  papiro?: boolean;
}
const { titulo, resumen, fecha, etiqueta, imagen, ejemplo, archivo, volver, papiro = false } = Astro.props;
---
<Base titulo={titulo} descripcion={resumen || undefined}>
  <article>
    <header class="contenedor pt-10 pb-14 md:pt-16">
      <a href={volver.href} class="rotulo text-tinta-suave transition-colors hover:text-rubrica" data-revelar>← {volver.texto}</a>
      <div class="mx-auto mt-14 max-w-[960px] text-center">
        <p class="rotulo text-rubrica" data-revelar>
          {etiqueta}
          {fecha && <><span class="mx-2 text-tinta-tenue">·</span> <time datetime={fecha.toISOString()} class="text-tinta-suave">{formatoFecha(fecha)}</time></>}
          {ejemplo && <span class="ml-2 text-tinta-tenue">· contenido de ejemplo</span>}
        </p>
        <Lineas as="h1" class="display-l mt-8" lineas={[titulo]} />
        {resumen && <p class="lede mx-auto mt-8 max-w-[48ch]" data-revelar style="--i:2">{resumen}</p>}
        <Tau trazar class="mx-auto mt-12 h-8 w-auto text-rubrica" />
      </div>
    </header>

    {imagen && (
      <div class="contenedor" data-revelar>
        <div class="parallax aspect-[16/9] overflow-hidden"><img src={imagen} alt="" class="h-full w-full object-cover" /></div>
      </div>
    )}

    <div class="contenedor pt-14 pb-10">
      <div class:list={[papiro && 'papiro rollo mx-auto max-w-[760px] px-6 py-14 sm:px-12 md:py-16']} data-revelar>
        <div class:list={['prosa mx-auto', papiro && 'oracion-texto']}>
          <slot />
        </div>
      </div>
      <slot name="despues" />
      {archivo && (
        <div class="mx-auto mt-12 max-w-[66ch]">
          <a href={archivo} class="boton" download>Descargar documento (PDF)</a>
        </div>
      )}
      <div class="mx-auto mt-16 max-w-[66ch] border-t border-tinta/15 pt-6">
        <a href={volver.href} class="enlace-flecha">{volver.texto}</a>
      </div>
    </div>
  </article>
  <Invitacion />
</Base>
