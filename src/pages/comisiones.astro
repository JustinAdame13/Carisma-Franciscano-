---
import Base from '../layouts/Base.astro';
import Portadilla from '../components/Portadilla.astro';
import Cita from '../components/Cita.astro';
import Invitacion from '../components/Invitacion.astro';
import { comisiones } from '../data/comisiones.json';
---
<Base titulo="Comisiones" descripcion="Las comisiones de la fraternidad Caridad Franciscana: formación, caridad, liturgia, creación, familia y comunicación.">
  <Portadilla
    href="/comisiones"
    lineas={['Cada hermano,', 'un *don* para los demás.']}
    entrada="La vida de la fraternidad se organiza en comisiones. Cada una cuida un aspecto de nuestra misión y todos podemos participar según nuestros dones y tiempos."
  />

  <section class="contenedor">
    <div class="grid gap-x-8 gap-y-16 md:grid-cols-2 lg:grid-cols-3">
      {comisiones.map((c, i) => (
        <article class="group border-t border-tinta pt-6" data-revelar style={`--i:${i % 3}`}>
          <span class="numeral block text-[3.4rem] leading-none transition-transform duration-700 ease-[var(--ease-suave)] group-hover:-translate-y-1">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h2 class="subtitulo mt-6">{c.nombre}</h2>
          <p class="mt-3 text-tinta-suave">{c.descripcion}</p>
          {c.responsable && <p class="rotulo mt-5 text-olivo">Responsable · {c.responsable}</p>}
        </article>
      ))}
    </div>

    <div class="mt-28 grid gap-12 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-7">
        <Cita autor="1 Pedro 4,10">
          Que cada uno ponga al servicio de los demás el don que ha recibido.
        </Cita>
      </div>
      <div class="md:col-span-4 md:col-start-9 md:self-end" data-revelar style="--i:1">
        <p class="text-tinta-suave">¿Te gustaría colaborar en alguna comisión? No necesitas ser miembro profeso para echar la mano.</p>
        <a href="/contacto" class="enlace-flecha mt-5">Quiero participar</a>
      </div>
    </div>
  </section>

  <Invitacion />
</Base>
