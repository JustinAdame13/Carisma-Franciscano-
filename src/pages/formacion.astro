---
import Base from '../layouts/Base.astro';
import Portadilla from '../components/Portadilla.astro';
import Rubro from '../components/Rubro.astro';
import Lineas from '../components/Lineas.astro';
import Lamina from '../components/Lamina.astro';
import Cita from '../components/Cita.astro';
import Invitacion from '../components/Invitacion.astro';
import sitio from '../data/sitio.json';

// PENDIENTE: confirmar con la fraternidad la duración de cada etapa y cuándo inician los grupos.
const etapas = [
  { n: 'I', nombre: 'Acogida', verbo: 'Conocernos', texto: 'Vienes a las reuniones, conoces a los hermanos y descubres si este estilo de vida te llama. Sin compromiso y a tu ritmo.' },
  { n: 'II', nombre: 'Iniciación', verbo: 'Discernir', texto: 'Un tiempo para profundizar en la vida de San Francisco y en lo que significa ser franciscano seglar, acompañado por un formador.' },
  { n: 'III', nombre: 'Formación inicial', verbo: 'Prepararse', texto: 'Después de la admisión, estudias la Regla, la oración y la vida fraterna, y participas plenamente en la fraternidad.' },
  { n: 'IV', nombre: 'Profesión', verbo: 'Comprometerse', texto: 'Ante la fraternidad y la Iglesia, prometes vivir el Evangelio según la Regla de la OFS. Es un compromiso para toda la vida.' },
];

const pasosVisita = [
  { titulo: 'Llegada y bienvenida', texto: 'Alguien de la fraternidad te saluda en la entrada y te presenta con los demás. Te puedes sentar donde quieras.', nota: 'Sin presiones' },
  { titulo: 'Un momento de oración', texto: 'Empezamos con una oración sencilla. Si no te sabes las oraciones, no pasa nada: puedes acompañar en silencio.', nota: 'Nadie te pedirá que hables' },
  { titulo: 'Tema y diálogo', texto: 'Compartimos un tema de formación o una reflexión del Evangelio, en un lenguaje claro y cercano a la vida diaria.', nota: 'Lenguaje sencillo' },
  { titulo: 'Café y convivencia', texto: 'Al terminar platicamos un rato con un café. Es el momento ideal para preguntar lo que quieras.', nota: 'Totalmente voluntario' },
];

const preguntas = [
  { p: '¿Cómo debo vestir?', r: 'Como te sientas cómodo. No hay código de vestimenta: vienes tal como eres. San Francisco eligió la sencillez; lo último que nos importa es la ropa.' },
  { p: '¿Tengo que saber rezar o conocer mucho de la Iglesia?', r: 'No. Muchos llegamos con dudas o después de años alejados. Aquí se aprende caminando, y nadie te va a examinar.' },
  { p: '¿Tengo que ser católico para ir?', r: 'Para conocernos, no. Cualquier persona que busque a Dios o tenga curiosidad es bienvenida. Si después deseas integrarte formalmente a la Orden, el formador te explicará el camino.' },
  { p: '¿Quedo comprometido si voy a una reunión?', r: 'Para nada. Puedes venir una vez, varias o las que quieras. El compromiso llega solo si tú lo decides, después de un tiempo de discernimiento.' },
  { p: '¿Puedo ir con mi familia o mis hijos?', r: 'Sí. Las familias son bienvenidas. Avísanos y buscamos la forma de que los niños también estén a gusto.' },
  { p: '¿Me van a pedir dinero?', r: 'No. Asistir es completamente gratuito. Si en algún momento quieres apoyar los proyectos de caridad, será siempre voluntario.' },
];

const permanente = sitio.reuniones.find((r) => r.titulo.toLowerCase().includes('formación'));
---
<Base titulo="Formación" descripcion="Cómo integrarte a la fraternidad Caridad Franciscana: etapas de formación, tu primera visita y preguntas frecuentes.">
  <Portadilla
    href="/formacion"
    lineas={['Nadie llega solo', 'ni con todo *resuelto*.']}
    entrada="Ser franciscano seglar es un camino que se recorre por etapas, a tu ritmo y siempre acompañado."
  >
    <div class="mt-8 flex flex-wrap items-center gap-6" data-revelar style="--i:4">
      <a href="#primera-visita" class="boton">Mi primera visita</a>
      <a href="#etapas" class="enlace-flecha">Las etapas</a>
    </div>
  </Portadilla>

  <!-- ETAPAS -->
  <section id="etapas" class="contenedor">
    <div class="grid gap-10 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-4"><Rubro numero="I" texto="El camino" /></div>
      <div class="md:col-span-8"><Lineas class="titulo" lineas={['Cuatro etapas,', 'un mismo *Evangelio*.']} /></div>
    </div>
    <ol class="relative mt-16 grid gap-12 md:grid-cols-4 md:gap-8">
      <span class="absolute top-[2.4rem] left-0 hidden h-px w-full bg-tinta md:block" data-regla aria-hidden="true"></span>
      {etapas.map((e, i) => (
        <li class="relative" data-revelar style={`--i:${i}`}>
          <span class="numeral relative inline-block bg-papel pr-4 text-[4.4rem] leading-none">{e.n}</span>
          <p class="rotulo mt-6 text-rubrica">{e.verbo}</p>
          <h3 class="subtitulo mt-2">{e.nombre}</h3>
          <p class="mt-3 text-tinta-suave">{e.texto}</p>
        </li>
      ))}
    </ol>

    <div class="mt-24 grid gap-12 border-t border-tinta pt-10 md:grid-cols-2 md:gap-8">
      <div data-revelar>
        <p class="rotulo text-tinta-suave">Requisitos para empezar</p>
        <p class="mt-3 font-display text-[clamp(3rem,6vw,5rem)] leading-none tracking-[-0.03em] italic text-rubrica" style="font-weight:340">Ninguno.</p>
        <p class="mt-5 max-w-[44ch] text-tinta-suave">Solo el deseo de conocer a Dios y a los hermanos. Si más adelante quieres hacer tu profesión, la fraternidad te explicará lo que pide la Iglesia para ese paso.</p>
      </div>
      <div data-revelar style="--i:1">
        <p class="rotulo text-tinta-suave">Formación permanente</p>
        <p class="mt-3 font-display text-[clamp(3rem,6vw,5rem)] leading-none tracking-[-0.03em]" style="font-weight:340">Para toda la vida.</p>
        <p class="mt-5 max-w-[44ch] text-tinta-suave">Los hermanos profesos seguimos formándonos: estudiamos la Regla, los escritos de San Francisco y Santa Clara y la enseñanza de la Iglesia.</p>
        {permanente && <p class="rotulo mt-5 text-olivo">{permanente.dia} · {permanente.hora}</p>}
      </div>
    </div>
  </section>

  <!-- PRIMERA VISITA -->
  <section id="primera-visita" class="mt-28 bg-noche py-24 text-papel md:mt-40 md:py-32">
    <div class="contenedor">
      <div class="grid gap-10 md:grid-cols-12 md:gap-8">
        <div class="md:col-span-4"><Rubro numero="II" texto="Guía de primera visita" claro /></div>
        <div class="md:col-span-8">
          <Lineas class="titulo text-papel!" lineas={['¿Qué pasa exactamente', 'cuando *llegas*?']} />
          <p class="lede mt-6 max-w-[48ch] text-papel/70!" data-revelar style="--i:2">Entendemos que llegar por primera vez a un grupo puede dar dudas o timidez. Este es el recorrido real de lo que vivirás.</p>
        </div>
      </div>
      <ol class="mt-16 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
        {pasosVisita.map((p, i) => (
          <li class="border-t border-papel/25 pt-6" data-revelar style={`--i:${i}`}>
            <span class="numeral text-[1.1rem]">Paso {String(i + 1).padStart(2, '0')}</span>
            <h3 class="subtitulo mt-4 text-papel">{p.titulo}</h3>
            <p class="mt-3 text-papel/70">{p.texto}</p>
            <p class="mt-5 font-texto italic text-papel/55">— {p.nota}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- PREGUNTAS -->
  <section class="contenedor pt-28 md:pt-40">
    <div class="grid gap-12 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-4">
        <Rubro numero="III" texto="Dudas que todos hemos tenido" />
        <Lineas class="titulo mt-6" lineas={['Preguntas', '*sinceras*.']} />
        <div class="mt-12 hidden md:block">
          <Lamina numero={4} pie="Un formador conversando con personas nuevas." proporcion="aspect-[3/4]" />
        </div>
      </div>
      <div class="md:col-span-7 md:col-start-6">
        <div class="border-b border-tinta/15">
          {preguntas.map((q, i) => (
            <details class="pregunta group border-t border-tinta/15" data-revelar style={`--i:${i}`} name="preguntas">
              <summary class="flex cursor-pointer list-none items-baseline gap-5 py-6 [&::-webkit-details-marker]:hidden">
                <span class="numeral w-8 shrink-0 text-[1rem]">{String(i + 1).padStart(2, '0')}</span>
                <span class="flex-1 font-display text-[1.45rem] leading-snug transition-colors group-hover:text-rubrica md:text-[1.65rem]">{q.p}</span>
                <span class="mas relative h-4 w-4 shrink-0 self-center" aria-hidden="true"></span>
              </summary>
              <p class="pb-7 pl-[3.25rem] text-[1.1rem] text-tinta-suave">{q.r}</p>
            </details>
          ))}
        </div>
        <div class="mt-16">
          <Cita autor="San Francisco · Regla no bulada, cap. 7">
            Y cualquiera que venga a ellos, amigo o adversario, ladrón o bandido, sea recibido benignamente.
          </Cita>
        </div>
      </div>
    </div>
  </section>

  <Invitacion lineas={['¿Prefieres que', 'alguien te *reciba*?']} texto="Si venir solo te da un poco de pena, avísanos. Un hermano de la fraternidad te esperará en la entrada para presentarte con todos." />
</Base>

<style>
  /* Signo + que gira a − al abrir la pregunta */
  .mas::before,
  .mas::after {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 100%;
    height: 1px;
    background: var(--color-tinta);
    transition: transform 0.5s var(--ease-suave);
  }
  .mas::after { transform: rotate(90deg); }
  .pregunta[open] .mas::after { transform: rotate(0deg); }

  /* Apertura suave (navegadores recientes) */
  @media (prefers-reduced-motion: no-preference) {
    .pregunta::details-content {
      block-size: 0;
      overflow: hidden;
      transition: block-size 0.55s var(--ease-suave), content-visibility 0.55s allow-discrete;
    }
    .pregunta[open]::details-content { block-size: auto; }
    :root { interpolate-size: allow-keywords; }
  }
</style>
