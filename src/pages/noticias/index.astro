---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Portadilla from '../../components/Portadilla.astro';
import FilaCronica from '../../components/FilaCronica.astro';
import { formatoFecha } from '../../lib/utilidades';

// Más recientes primero. Las entradas se agregan desde el panel /keystatic.
const entradas = (await getCollection('noticias')).sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf());
const [destacada, ...resto] = entradas;
---
<Base titulo="Noticias" descripcion="Avisos, eventos y momentos que compartimos como fraternidad y con la comunidad parroquial.">
  <Portadilla href="/noticias" lineas={['Lo que vivimos', 'en *fraternidad*.']} entrada="Avisos, eventos y momentos que compartimos como fraternidad y con la comunidad parroquial." />

  <section class="contenedor pb-28 md:pb-40">
    {destacada ? (
      <>
        <!-- Entrada destacada -->
        <a href={`/noticias/${destacada.id}`} class="group grid gap-10 md:grid-cols-12 md:gap-8" data-revelar>
          <div class="md:col-span-7">
            {destacada.data.imagen ? (
              <div class="parallax aspect-[16/10] overflow-hidden bg-papel-hondo"><img src={destacada.data.imagen} alt="" class="h-full w-full object-cover" /></div>
            ) : (
              <div class="grano flex aspect-[16/10] items-end bg-papel-hondo p-6 md:p-10">
                <span class="font-display text-[clamp(4rem,10vw,9rem)] leading-[0.8] tracking-[-0.04em] text-sayal/15 italic">{destacada.data.categoria}</span>
              </div>
            )}
          </div>
          <div class="md:col-span-5 md:self-end">
            <p class="rotulo text-rubrica">{destacada.data.categoria}{destacada.data.ejemplo && <span class="ml-2 text-tinta-tenue">· ejemplo</span>}</p>
            <h2 class="titulo mt-4 transition-colors duration-500 group-hover:text-rubrica">{destacada.data.titulo}</h2>
            <p class="lede mt-5">{destacada.data.resumen}</p>
            <p class="rotulo mt-6 text-tinta-suave">{formatoFecha(destacada.data.fecha)}</p>
          </div>
        </a>
        {resto.length > 0 && (
          <ul class="mt-20 border-b border-tinta/15">
            {resto.map((e, i) => (
              <FilaCronica
                href={`/noticias/${e.id}`}
                titulo={e.data.titulo}
                fecha={e.data.fecha}
                resumen={e.data.resumen}
                etiqueta={e.data.categoria}
                ejemplo={e.data.ejemplo}
                i={i}
              />
            ))}
          </ul>
        )}
      </>
    ) : (
      <p class="lede border-t border-tinta/15 pt-10 italic">Muy pronto compartiremos aquí avisos y noticias de la fraternidad.</p>
    )}
  </section>
</Base>
