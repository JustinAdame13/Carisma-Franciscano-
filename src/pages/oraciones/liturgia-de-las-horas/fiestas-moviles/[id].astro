---
import Base from '../../../../layouts/Base.astro';
import SubnavOraciones from '../../../../components/SubnavOraciones.astro';
import CelebracionLiturgica from '../../../../components/CelebracionLiturgica.astro';
import { BASE, FUENTE, calendario } from '../../../../lib/liturgia';

// Fiestas que cambian de fecha cada año porque dependen de la Pascua.
export function getStaticPaths() {
  return calendario.filter((e) => !e.dia && e.celebracion).map((e) => ({ params: { id: e.celebracion }, props: { entrada: e } }));
}
const { entrada } = Astro.props;
---
<Base titulo={`${entrada.nombre} · Liturgia de las Horas`} descripcion={`Liturgia de las Horas franciscana: ${entrada.nombre} (${entrada.movil}).`}>
  <div class="pt-8 md:pt-12"><SubnavOraciones activa="liturgia" /></div>
  <header class="contenedor pt-12 pb-6 text-center md:pt-16">
    <a href={`${BASE}/`} class="rotulo text-tinta-suave transition-colors hover:text-rubrica">← Calendario</a>
    <p class="mt-8 font-display text-[clamp(1.6rem,3vw,2.2rem)] italic text-rubrica">{entrada.movil}</p>
    <p class="mt-3 font-texto italic text-tinta-suave">Fiesta móvil: su fecha depende de la Pascua de cada año.</p>
  </header>
  <div class="contenedor py-10">
    <CelebracionLiturgica entrada={entrada} fecha={entrada.movil ?? ''} />
  </div>
  <p class="contenedor pb-20 font-texto text-[0.9rem] italic text-tinta-tenue">Textos: {FUENTE}.</p>
</Base>
