---
import Base from '../../../layouts/Base.astro';
import Portadilla from '../../../components/Portadilla.astro';
import SubnavOraciones from '../../../components/SubnavOraciones.astro';
import Tau from '../../../components/Tau.astro';
import { FUENTE, MESES, calendario, desfaseMovil, rangoPrincipal, urlEntrada } from '../../../lib/liturgia';

/*
  El sitio es estático: esta página se genera una vez al publicar.
  Para que "Hoy" cambie solo cada día, un pequeño script en el navegador
  lee la fecha del visitante y busca en estos datos.
*/
const datos = calendario.map((e) => ({
  m: e.mes,
  d: e.dia,
  movil: e.movil ? desfaseMovil(e.movil) : null,
  nombre: e.nombre,
  rango: rangoPrincipal(e.rangos),
  url: urlEntrada(e),
  textos: Boolean(e.celebracion),
}));

const porMes = MESES.map((nombre, i) => {
  const delMes = calendario.filter((e) => e.mes === i + 1 && e.dia);
  const dias = [...new Set(delMes.map((e) => e.dia!))].sort((a, b) => a - b);
  return { nombre, mes: i + 1, dias: dias.map((d) => ({ dia: d, entradas: delMes.filter((e) => e.dia === d) })) };
});
const moviles = calendario.filter((e) => !e.dia);
---
<Base titulo="Liturgia de las Horas" descripcion="Liturgia de las Horas del Propio de la Familia Franciscana: la celebración de hoy y el calendario de santos franciscanos.">
  <Portadilla
    href="/oraciones"
    lineas={['Santificar', 'cada *hora*.']}
    entrada="El Propio de la Familia Franciscana: los santos y las fiestas de la familia de San Francisco, con su Oficio de lectura, Laudes y Vísperas."
  />
  <SubnavOraciones activa="liturgia" />

  <!-- HOY -->
  <section class="contenedor pt-16 md:pt-20">
    <div id="hoy" class="papiro mx-auto max-w-[860px] px-6 py-12 text-center sm:px-12 md:py-16" data-revelar>
      <Tau class="mx-auto h-8 w-auto text-rubrica" />
      <p class="rotulo mt-6" data-hoy-fecha>Hoy</p>
      <div data-hoy-contenido class="mt-6">
        <noscript>
          <p class="italic">Consulta la celebración de hoy en el calendario de abajo.</p>
        </noscript>
      </div>
    </div>
  </section>

  <!-- CALENDARIO -->
  <section class="contenedor pt-24 pb-10 md:pt-32">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <h2 class="titulo" data-revelar>Calendario <em class="text-rubrica">franciscano</em></h2>
      <p class="max-w-[46ch] text-[1rem] text-tinta-suave" data-revelar style="--i:1">
        Toca un día para leer su oficio. Los días sin celebración propia se rezan con el oficio del día de la Iglesia universal.
      </p>
    </div>

    <div class="mt-10 flex flex-wrap gap-x-1 gap-y-2 border-b border-tinta/15" role="tablist" aria-label="Meses" data-meses hidden>
      {MESES.map((m, i) => (
        <button type="button" role="tab" data-mes-boton={i + 1} class="mes-boton -mb-px border-b border-transparent px-2.5 py-2 font-ui text-[0.7rem] font-semibold tracking-[0.12em] uppercase text-tinta-suave transition-colors hover:text-rubrica">
          {m.slice(0, 3)}
        </button>
      ))}
    </div>

    {porMes.map((m) => (
      <div class="mes mt-10" data-mes={m.mes} role="tabpanel">
        <h3 class="rotulo text-rubrica">{m.nombre}</h3>
        <ul class="mt-4 border-b border-tinta/15">
          {m.dias.map(({ dia, entradas }) => (
            <li data-dia={`${m.mes}-${dia}`} class="dia">
              <a href={urlEntrada(entradas[0])} class="group grid grid-cols-[3.5rem_1fr_auto] items-baseline gap-x-4 border-t border-tinta/15 py-5 transition-colors duration-500 hover:bg-papel-hondo/50 md:grid-cols-[5rem_1fr_auto]">
                <span class="numeral text-[1.8rem] leading-none md:text-[2.3rem]">{dia}</span>
                <span class="space-y-2">
                  {entradas.map((e) => (
                    <span class="block">
                      <span class="block font-display text-[1.2rem] leading-snug transition-colors group-hover:text-rubrica md:text-[1.35rem]">{e.nombre}</span>
                      <span class="block text-[0.92rem] text-tinta-suave italic">
                        {rangoPrincipal(e.rangos)}{!e.celebracion && ' · sin textos propios'}
                      </span>
                    </span>
                  ))}
                </span>
                <span class="hoy-marca rotulo hidden text-rubrica">Hoy</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}

    {moviles.length > 0 && (
      <div class="mt-16">
        <h3 class="rotulo text-rubrica">Fiestas móviles</h3>
        <ul class="mt-4 border-b border-tinta/15">
          {moviles.map((e) => (
            <li>
              <a href={urlEntrada(e)} class="group block border-t border-tinta/15 py-5">
                <span class="block font-display text-[1.25rem] transition-colors group-hover:text-rubrica">{e.nombre}</span>
                <span class="block text-[0.92rem] text-tinta-suave italic">{e.movil}<span data-movil-fecha={desfaseMovil(e.movil ?? '')}></span></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <p class="mt-16 max-w-[70ch] text-[0.95rem] text-tinta-suave">
      <span class="rotulo text-rubrica">Cómo leer el rango ·</span> Solemnidad y Fiesta son los grados mayores; Memoria obligatoria se celebra siempre; Memoria libre, si se desea. Cada rama de la Familia Franciscana (frailes, clarisas, capuchinos, Orden Seglar…) puede celebrar al mismo santo con distinto grado; el detalle aparece en la página de cada día.
    </p>
    <p class="mt-6 font-texto text-[0.9rem] italic text-tinta-tenue">Textos: {FUENTE}.</p>
  </section>

  <script type="application/json" id="liturgia-datos" set:html={JSON.stringify(datos)} />

  <script>
    // Elige la celebración de hoy según la fecha del visitante y prepara el calendario.
    const MESES = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
    type Dato = { m: number; d: number | null; movil: number | null; nombre: string; rango: string; url: string; textos: boolean };

    /** Domingo de Pascua (algoritmo de Meeus/Jones/Butcher, calendario gregoriano). */
    function pascua(y: number) {
      const a = y % 19, b = Math.floor(y / 100), c = y % 100, d = Math.floor(b / 4), e = b % 4;
      const f = Math.floor((b + 8) / 25), g = Math.floor((b - f + 1) / 3), h = (19 * a + b - d - g + 15) % 30;
      const i = Math.floor(c / 4), k = c % 4, l = (32 + 2 * e + 2 * i - h - k) % 7, m = Math.floor((a + 11 * h + 22 * l) / 451);
      const mes = Math.floor((h + l - 7 * m + 114) / 31), dia = ((h + l - 7 * m + 114) % 31) + 1;
      return new Date(y, mes - 1, dia);
    }
    const sumarDias = (f: Date, n: number) => new Date(f.getFullYear(), f.getMonth(), f.getDate() + n);
    const texto = (f: Date) => `${f.getDate()} de ${MESES[f.getMonth()]}`;
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

    function iniciarLiturgia() {
      const nodo = document.getElementById('liturgia-datos');
      const caja = document.querySelector<HTMLElement>('[data-hoy-contenido]');
      if (!nodo || !caja) return;
      const datos: Dato[] = JSON.parse(nodo.textContent || '[]');
      const hoy = new Date();
      hoy.setHours(0, 0, 0, 0);

      const delDia = (f: Date) =>
        datos.filter((x) => {
          if (x.d) return x.m === f.getMonth() + 1 && x.d === f.getDate();
          if (x.movil === null) return false;
          return sumarDias(pascua(f.getFullYear()), x.movil).getTime() === f.getTime();
        });

      const tarjeta = (lista: Dato[], grande = true) =>
        lista
          .map(
            (x) => `
          <h2 class="mx-auto max-w-[26ch] font-display ${grande ? 'text-[clamp(1.8rem,4vw,2.7rem)]' : 'text-[clamp(1.3rem,2.4vw,1.7rem)]'} leading-[1.1] tracking-[-0.02em]" style="font-weight:380">${esc(x.nombre)}</h2>
          ${x.rango ? `<p class="mt-3 font-texto italic text-rubrica">${esc(x.rango)}</p>` : ''}`,
          )
          .join(`<span class="mx-auto ${grande ? 'my-8' : 'my-5'} block h-px w-16 bg-current opacity-30"></span>`);

      const fechaEl = document.querySelector('[data-hoy-fecha]');
      if (fechaEl) fechaEl.textContent = `Hoy · ${texto(hoy)}`;
      const deHoy = delDia(hoy);
      if (deHoy.length) {
        caja.innerHTML = `${tarjeta(deHoy)}
          <a href="${deHoy[0].url}" class="boton mt-10">${deHoy.some((x) => x.textos) ? 'Rezar el oficio' : 'Ver la celebración'}</a>`;
      } else {
        let prox: Date | null = null;
        let lista: Dato[] = [];
        for (let n = 1; n <= 366 && !prox; n++) {
          const f = sumarDias(hoy, n);
          const l = delDia(f);
          if (l.length) { prox = f; lista = l; }
        }
        caja.innerHTML = `<p class="mx-auto max-w-[40ch] font-texto text-[1.15rem] italic">Hoy no hay una celebración propia franciscana: se reza el oficio del día de la Iglesia universal.</p>
          ${prox ? `<p class="rotulo mt-10">Próxima celebración · ${texto(prox)}</p><div class="mt-5">${tarjeta(lista, false)}</div>
          <a href="${lista[0].url}" class="enlace-flecha mt-8">Ver el oficio</a>` : ''}`;
      }

      // Fecha de este año para las fiestas móviles
      document.querySelectorAll<HTMLElement>('[data-movil-fecha]').forEach((el) => {
        const n = Number(el.dataset.movilFecha);
        if (!Number.isNaN(n) && el.dataset.movilFecha !== '') el.textContent = ` · este año: ${texto(sumarDias(pascua(hoy.getFullYear()), n))}`;
      });

      // Pestañas de meses: abre el mes actual
      const tabs = document.querySelector<HTMLElement>('[data-meses]');
      const paneles = document.querySelectorAll<HTMLElement>('[data-mes]');
      const mostrar = (mes: number) => {
        paneles.forEach((p) => (p.hidden = Number(p.dataset.mes) !== mes));
        document.querySelectorAll<HTMLElement>('[data-mes-boton]').forEach((b) => {
          const activo = Number(b.dataset.mesBoton) === mes;
          b.setAttribute('aria-selected', String(activo));
          b.classList.toggle('text-rubrica', activo);
          b.classList.toggle('border-rubrica', activo);
        });
      };
      if (tabs) {
        tabs.hidden = false;
        tabs.querySelectorAll<HTMLElement>('[data-mes-boton]').forEach((b) => b.addEventListener('click', () => mostrar(Number(b.dataset.mesBoton))));
        mostrar(hoy.getMonth() + 1);
      }
      const filaHoy = document.querySelector(`[data-dia="${hoy.getMonth() + 1}-${hoy.getDate()}"]`);
      filaHoy?.querySelector('.hoy-marca')?.classList.remove('hidden');
    }

    document.addEventListener('astro:page-load', iniciarLiturgia);
  </script>
</Base>
